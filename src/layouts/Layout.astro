---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Confectionery Delights</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");
	/* @import url("https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"); */

	html,
	body {
		font-family: "Roboto", "Times New Roman";
		/* font-family: "Cabin", "Times New Roman"; */
		color: #ccc;
		background-color: rgb(0, 0, 0);
		display: flex;
		flex-direction: column;
		justify-items: center;
		align-items: center;
	}
	/* * {
		padding: 0;
		box-sizing: border-box;
		margin: 0;
	} */

	.container {
		width: 100dvw;
		padding: 1rem 2rem;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		/* background-color: rgb(0, 0, 0); */
	}

	.footer-container {
		width: 100dvw;
		height: auto;
		margin: 3rem 0rem;
		text-align: center;
		background-color: rgb(0, 0, 0);
	}

	.grid-container {
		width: 90dvw;
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.product_grid {
		max-width: 80dvw;
		/* background-color: rgb(14, 12, 17); */
		/* padding: 1rem; */
		gap: 1rem;
		display: grid;
		align-content: center;
		justify-content: center;
		/* grid-template-columns: repeat(auto-fit, 18rem); */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}

	.card {
		width: 18rem;
		background-color: burlywood;
		/* max-height: 400px; */
		border: #fff 5px solid;
		border-radius: 0.5rem;
		display: flex;
		flex-direction: column;
		/* align-items: center; */
		justify-content: space-evenly;
		padding: 0.5rem;
		margin: 0 auto;
		color: black;
	}
	.card-title {
		text-align: center;
		margin-bottom: 1.5rem;
		overflow-wrap: break-word;
	}

	img {
		width: 100%;
		height: auto;
	}
	.card-image {
		width: 100%;
		height: auto;
	}
	.card-price {
		margin-top: 1rem;
	}

	.card-description {
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	ul {
		list-style-type: none;
	}

	a {
		text-decoration: none;
		list-style: none;
	}

	.nav-list {
		display: flex;
		flex-direction: row;
		margin-right: 2rem;
	}

	.nav-list > li {
		margin-right: 2rem;
	}
</style>
