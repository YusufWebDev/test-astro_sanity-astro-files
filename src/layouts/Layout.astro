---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Confectionery Delights</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");
	/* @import url("https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"); */

	html {
		padding: 0;
		margin: 0;
	}
	* {
		box-sizing: border-box;
	}
	body {
		font-family: "Roboto", "Times New Roman";
		/* font-family: "Cabin", "Times New Roman"; */
		color: #fffefe;
		padding: 0 3rem;
		/* width: 100%; */
		background-color: rgb(0, 0, 0);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
	}

	.container {
		width: 100dvw;
		padding: 0 5rem;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		align-content: center;
		margin: 0 auto;
		background-color: rgb(208, 61, 61);
	}

	.header {
		/* background-color: blue; */
		width: 100dvw;
		margin-top: 1rem;
		padding: 2rem;
		/* height: 6rem; */
	}
	.headerImg {
		width: 200px;
		height: 100%;
	}
	.headerImg > img {
		width: 100%;
		height: auto;
	}

	.footer-container {
		width: 90%;
		height: auto;
		margin: 3rem 0rem;
		text-align: center;
		background-color: rgb(0, 0, 0);
	}

	.grid-container {
		width: 90%;
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.product_grid {
		width: 100%;
		padding: 0 2rem;
		background-color: rgb(161, 139, 193);
		/* padding: 1rem; */
		gap: 1rem;
		display: grid;
		align-content: center;
		justify-content: center;
		/* grid-template-columns: repeat(auto-fit, 18rem); */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	}

	.card {
		width: 20rem;
		background-color: rgb(245, 225, 200);
		/* max-height: 400px; */
		border: #fff 5px solid;
		border-radius: 1rem;
		display: flex;
		flex-direction: column;
		/* align-items: center; */
		justify-content: space-evenly;
		padding: 0.5rem;
		margin: 0 auto;
		color: black;
	}
	.card-title {
		text-align: center;
		margin-bottom: 1.5rem;
		overflow-wrap: break-word;
	}

	img {
		width: 100%;
		height: auto;
	}
	.card-image {
		width: 100%;
		height: auto;
	}
	.card-price {
		margin-top: 1rem;
	}

	.card-description {
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	ul {
		list-style-type: none;
	}

	a {
		text-decoration: none;
		list-style: none;
	}

	.nav-list {
		display: flex;
		flex-direction: row;
		/* margin-right: 2rem; */
	}

	.nav-list > li {
		margin-left: 2rem;
	}

	/* mobile - 600px and less */

	@media only screen and (max-width: 600px) {
		.header {
			flex-direction: column;
		}
		.nav-list {
			margin-top: 2rem; /* margin-right: 2rem; */
		}
	}
</style>
