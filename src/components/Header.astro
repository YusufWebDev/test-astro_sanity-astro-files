---
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";
import { Image } from "astro:assets";
import logo from "../assets/logo1.png";
import { object, undefined } from "astro:schema";
// THIS IS TO GET THE IMAGE URL FROM SANITY TO SHOW ON THE PAGE.
const builder = createImageUrlBuilder(sanityClient);

function urlFor(source: any) {
	return builder.image(source);
}

//Even though this only returns one image , you have to loop throuhgh it to displat the image using the urlFor Function
//from the Sanity docs.
const COMPANY_LOGO_QUERY = `*[_type == 'companyLogo']{name, image, alt_Text}`;
const CompanyLogo = await sanityClient.fetch(COMPANY_LOGO_QUERY);
// console.log(CompanyLogo);

interface logoDetails {
	name: string;
	image: string;
	alt_Text: string;
}

// let logoDetailsImageFromSanity = CompanyLogo.image;
// let showAlternateLogoImage = true;

// if (logoDetailsImageFromSanity != null || "undefined") {
// 	showAlternateLogoImage = true;
// } else {
// 	showAlternateLogoImage = false;
// }
// console.log(logoDetailsImageFromSanity);
// console.log(showAlternateLogoImage);
---

<header>
	<div class="container">
		<a href="/">
			<div>
				{
					//you have to loop through the single row of data to get the url for the image.
					CompanyLogo.map((logo: logoDetails) => (
						<img
							src={urlFor(logo.image).width(250).height(100)}
							alt={logo.alt_Text}
							class="rounded-2xl"
						/>
					))
				}
			</div>
		</a>
		<nav class="nav">
			<ul class="nav-list">
				<li class="text-xl"><a href="/"></a>Home</li>
				<li class="text-xl"><a href="/contact">Contact</a></li>
				<li class="text-xl"><a href="/about">About</a></li>
			</ul>
		</nav>
	</div>
</header>
