---
import { sanityClient } from "sanity:client";
import urlFor from "../utils/sanityImageUrl.js";
import { Image } from "astro:assets";
import heroImageDefault from "../assets/hero2.jpg";
const hero_QUERY = `*[ _type == 'heroSectionDetails']{heading, subHeading, heroImage, alt_Text}`;
const heroDetails = await sanityClient.fetch(hero_QUERY);
const heroDetailsFromSanity = false;

interface hero {
	heroHeading: "string";
	herSubHeading: "string";
	heroImage: "string";
	heroImageAlt_Text: "string";
}
---

<hero
	class="max-w-100dvw max-h-75dvh grid grid-cols-1 my-0 mx-auto bg-linear-to-bl from-blue-800 to-mist-900 rounded-4xl mt-3"
>
	{
		heroDetailsFromSanity ? (
			heroDetails.map((d: hero) => {
				<div>
					<div>
						<h1>{d.heroHeading}</h1>
						<h2>{d.herSubHeading}</h2>
					</div>
					<div>
						<img src={urlFor(d.heroImage)} alt={d.heroImageAlt_Text} />
					</div>
				</div>;
			})
		) : (
			<div class=" w-[90dvw] h-[75dvh] grid grid-cols-2 my-0 mx-auto gap-2 p-3">
				<div class="flex flex-col items-start justify-center pl-16 pr-4 py-3">
					<h1 class="text-6xl/18 mb-8 uppercase">
						Is your <span class="font-bold text-amber-400">night driving </span>
						becoming
						<span class="font-bold text-amber-400"> dangerous </span> due to
						cloudy, yellowed, or hazy headlights?
					</h1>
					<h2 class="text-3xl mb-8">
						<span class="font-bold text-amber-400">Don't spend thousands</span>{" "}
						on brand-new headlight replacements !
					</h2>
					<h2 class="text-xl mb-8">
						<p>Here at Cape Town Headlight Restorations </p>
						<span class="font-bold text-amber-400">
							We restore your faded lenses{" "}
						</span>{" "}
						back to a crystal-clear, factory finish.
					</h2>
					<div>
						<a
							href="#"
							class="text-2xl bg-blue-800 text-amber-50 rounded-xl hover:pointer px-5 py-2"
						>
							<span>Book Now!</span>
						</a>
					</div>
				</div>
				<div class="max-w-150 bg-emerald-400 my-0 mx-auto rounded-3xl overflow-hidden self-center">
					<Image src={heroImageDefault} alt="Hero image of clean headlights " />
				</div>
			</div>
		)
	}
</hero>
