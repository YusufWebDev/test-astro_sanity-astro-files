---
interface Props {
	questionStatement: string;
}

const { questionStatement = "no more dull headlights" } = Astro.props;
---

<div
	class="w-full mt-15 h-75 bg-blue-950 px-5 text-amber-300 text-5xl flex flex-col text-center items-center justify-center uppercase font-bold"
>
	<h1>{questionStatement}</h1>
</div>
