---
import Layout from "../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import urlFor from "../utils/sanityImageUrl.js";
import "../styles/global.css";
import HeroSection from "../components/HeroSection.astro";
import QuestionStatementBanner from "../components/QuestionStatementBanner.astro";
import RestoreSection from "../components/RestoreSection.astro";
import ProcessSteps from "../components/ProcessSteps.astro";

interface Product {
	name: string;
	price: number;
	description: string;
	showOnSite: boolean;
	image: string;
	alt_Text: string;
}
// FETCHING ALL PRODUCT TYPES FROM SANITY.
const PRODUCT_QUERY = `*[ _type == 'product']{name, price, description, showOnSite, image, alt_Text}`;
const Products = await sanityClient.fetch(PRODUCT_QUERY);

// console.log(Products)
const filteredProdcts = Products.filter((p: Product) => p.showOnSite === true);
// console.log(filteredProdcts)
---

<Layout>
	<HeroSection />
	<QuestionStatementBanner
		questionStatement="Tired of struggling to see the road at night ?"
	/>
	<div class="grid-container">
		<div class="product_grid">
			{
				filteredProdcts.map((p: Product) => (
					<div class="card">
						<div class="card-title">
							<h2>{p.name}</h2>
						</div>
						<div class="card-image">
							<img src={urlFor(p.image).width(350)} alt={p.alt_Text} />
						</div>
						{/* <p>{p.showOnSite}</p> */}
						<div class="card-price">
							<p>R {p.price}</p>
						</div>
						<div class="card-description">
							<p>{p.description}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
	<RestoreSection />
	<ProcessSteps />
	<QuestionStatementBanner questionStatement="We come to you !" />
</Layout>
